{
  "name": "@kanrai/db",
  "version": "0.0.1",
  "private": true,
  "description": "Reads the DB schema from Prisma, Drizzle, TypeORM, Sequelize, Django, SQLAlchemy or SQLModel into kanrai's db.json.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@kanrai/core": "0.0.1",
    "@mrleebo/prisma-ast": "^0.16.0",
    "chokidar": "^4.0.3",
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "picomatch": "^4.0.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/picomatch": "^3.0.2",
    "drizzle-orm": "^0.45.2",
    "tsup": "^8.3.5"
  }
}
